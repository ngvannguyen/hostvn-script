# Migrate existing virtual hosts from listen ... http2 to modern syntax
for vhost_file in /etc/nginx/conf.d/*.conf /etc/nginx/alias/*.conf; do
    if [ -f "${vhost_file}" ] && grep -q 'listen .*http2;' "${vhost_file}"; then
        sed -i 's/listen 443 ssl http2;/listen 443 ssl;/g' "${vhost_file}"
        sed -i 's/listen \[::\]:443 ssl http2;/listen [::]:443 ssl;/g' "${vhost_file}"
        if ! grep -q 'http2 on;' "${vhost_file}"; then
            sed -i '/listen 443 ssl;/a \    http2 on;' "${vhost_file}"
        fi
    fi
done

# Create wrappers to silence MariaDB 11.4+ deprecation warnings
for cmd in mysql:mariadb mysqldump:mariadb-dump mysqlshow:mariadb-show mysqladmin:mariadb-admin mysqlcheck:mariadb-check mysqlimport:mariadb-import mysqlupgrade:mariadb-upgrade; do
    legacy="${cmd%%:*}"
    modern="${cmd##*:}"
    cat > "/usr/local/bin/${legacy}" << EOF
#!/bin/sh
exec /usr/bin/${modern} "\$@"
EOF
    chmod +x "/usr/local/bin/${legacy}"
done

