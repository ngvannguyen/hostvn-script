_safe_reload_nginx() {
    if nginx -t >/dev/null 2>&1; then
        systemctl reload nginx 2>/dev/null || systemctl start nginx 2>/dev/null
        return $?
    fi
    echo "ERROR: Cau hinh Nginx bi loi (nginx -t). Dang tu dong rollback..."
    nginx -t || true
    if [ -d "${BAK_DIR}/nginx" ]; then
        mv /etc/nginx "${BAK_DIR}/nginx_broken" && cp -a "${BAK_DIR}/nginx" /etc/nginx
        nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
    fi
    return 1
}

_safe_reload_php() {
    local v fpm_bin rc=0
    for v in "${php1_version}" "${php2_version}"; do
        [ -z "${v}" ] && continue
        [ -d "/etc/php/${v}/fpm" ] || continue
        fpm_bin=$(command -v "php-fpm${v}" 2>/dev/null || echo "/usr/sbin/php-fpm${v}")
        if [ -x "${fpm_bin}" ] && ! "${fpm_bin}" -t >/dev/null 2>&1; then
            echo "ERROR: Cau hinh PHP-FPM ${v} bi loi. Dang tu dong rollback..."
            "${fpm_bin}" -t || true
            if [ -d "${BAK_DIR}/php/${v}" ]; then
                mv "/etc/php/${v}" "${BAK_DIR}/php_${v}_broken" && cp -a "${BAK_DIR}/php/${v}" "/etc/php/${v}"
            fi
            rc=1
        else
            systemctl reload "php${v}-fpm" 2>/dev/null || systemctl restart "php${v}-fpm" 2>/dev/null || rc=1
        fi
    done
    return "${rc}"
}

_safe_restart_mariadb() {
    if command -v mariadbd >/dev/null 2>&1; then
        if ! mariadbd --validate-config >/dev/null 2>&1; then
            echo "ERROR: Cau hinh MariaDB (/etc/mysql/my.cnf) khong hop le. Dang tu dong rollback..."
            mariadbd --validate-config || true
            [ -f "${BAK_DIR}/my.cnf" ] && cp -a "${BAK_DIR}/my.cnf" /etc/mysql/my.cnf
            return 1
        fi
    fi
    if ! systemctl restart mariadb 2>/dev/null; then
        echo "ERROR: Khoi dong lai MariaDB that bai. Dang tu dong rollback /etc/mysql/my.cnf..."
        [ -f "${BAK_DIR}/my.cnf" ] && cp -a "${BAK_DIR}/my.cnf" /etc/mysql/my.cnf
        systemctl restart mariadb 2>/dev/null || true
        return 1
    fi
    return 0
}

