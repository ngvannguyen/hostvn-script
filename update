    mkdir -p "${BAK_DIR}/stage"
    if ! tar -xf menu_new.tar.gz -C "${BAK_DIR}/stage" || [ ! -f "${BAK_DIR}/stage/menu/hostvn" ]; then
        echo "ERROR: Giai nen menu_new.tar.gz that bai hoac thieu menu/hostvn. Giu nguyen menu hien tai."
        rm -f menu_new.tar.gz
        exit 1
    fi

    # Chuan hoa quyen va dinh dang LF trong thu muc tam truoc khi kiem tra cu phap
    chmod +x "${BAK_DIR}/stage/menu"/* "${BAK_DIR}/stage/menu"/*/* "${BAK_DIR}/stage/menu"/*/*/* "${BAK_DIR}/stage/menu"/*/*/*/* 2>/dev/null || true
    chmod +x "${BAK_DIR}/stage/menu/cronjob"/* 2>/dev/null || true
    find "${BAK_DIR}/stage/menu" -type f -exec dos2unix -q {} + 2>/dev/null || true

    # Kiem tra cu phap toan bo bash script trong ban cap nhat truoc khi thay the
    syntax_err=0
    while IFS= read -r -d '' sf; do
        first_line=$(head -n 1 "${sf}" 2>/dev/null || true)
        if [[ "${first_line}" == "#!"*bash* ]]; then
            if ! bash -n "${sf}"; then
                echo "ERROR: Loi cu phap Bash trong goi cap nhat: ${sf}"
                syntax_err=1
            fi
        elif [[ "${first_line}" == "#!"*/sh* ]]; then
            if ! sh -n "${sf}"; then
                echo "ERROR: Loi cu phap sh trong goi cap nhat: ${sf}"
                syntax_err=1
            fi
        fi
    done < <(find "${BAK_DIR}/stage/menu" -path "${BAK_DIR}/stage/menu/template" -prune -o -type f -print0)

    # Kiem tra cu phap Python cua Telegram Bot (neu co python3/venv)
    py_bin=""
    if [ -x "/var/hostvn/menu/telegram_bot/venv/bin/python" ]; then
        py_bin="/var/hostvn/menu/telegram_bot/venv/bin/python"
    elif command -v python3 >/dev/null 2>&1; then
        py_bin="python3"
    fi
    if [ -n "${py_bin}" ] && ls "${BAK_DIR}/stage/menu/telegram_bot"/*.py >/dev/null 2>&1; then
        if ! "${py_bin}" -m py_compile "${BAK_DIR}/stage/menu/telegram_bot"/*.py; then
            echo "ERROR: Loi cu phap Python trong telegram_bot cua goi cap nhat."
            syntax_err=1
        fi
    fi

    if [ "${syntax_err}" -ne 0 ]; then
        echo "ERROR: Goi menu moi co loi cu phap. Huy cap nhat, giu nguyen /var/hostvn/menu hien tai."
        rm -f menu_new.tar.gz
        exit 1
    fi

    # Bao ton venv cua telegram bot truoc khi doi thu muc menu/
    if [ -d "/var/hostvn/menu/telegram_bot/venv" ]; then
        mv /var/hostvn/menu/telegram_bot/venv "${BAK_DIR}/tgbot_venv"
    fi
    rm -rf /var/hostvn/menu.bak
    [ -d /var/hostvn/menu ] && mv /var/hostvn/menu /var/hostvn/menu.bak
    mv "${BAK_DIR}/stage/menu" /var/hostvn/menu
    rm -f menu_new.tar.gz
    # Khoi phuc venv sau khi swap
    if [ -d "${BAK_DIR}/tgbot_venv" ]; then
        mkdir -p /var/hostvn/menu/telegram_bot
        mv "${BAK_DIR}/tgbot_venv" /var/hostvn/menu/telegram_bot/venv
    fi
