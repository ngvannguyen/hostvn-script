source /var/hostvn/menu/validate/rule
source /var/hostvn/menu/helpers/function

_create_drive_connect(){
    source /var/hostvn/menu/controller/backup/connect_google_drive
    _select_remote
    if [[ -z "${remote}" ]]; then
        clear
        printf "%s
" "${RED}Ban da huy thao tac.${NC}"
    else
        _run
    fi
}

_select_type(){
    echo "Lua chon kieu backup ?"
    PS3='Nhap lua chon cua ban (1-4): '
    options=("Backup theo ten mien" "Backup toan bo ten mien" "Xem danh sach ten mien da tao backup" "Huy tao cronjob")
    select opt in "${options[@]}"
    do
        case $opt in
            "Backup theo ten mien") type="one"; break;;
            "Backup toan bo ten mien") type="all"; break;;
            "Xem danh sach ten mien da tao backup") type="list"; break;;
            "Huy tao cronjob") type="0"; break;;
            *) printf "%s\n" "${RED}Ban nhap sai, vui long nhap lai.${NC}";;
        esac
    done
}

_get_backed_up_domains(){
    backed_domains=()
    if [ -d "${BASH_DIR}/ggdrive" ]; then
        for f in "${BASH_DIR}"/ggdrive/*; do
            [ -f "${f}" ] || continue
            local d
            d=$(basename "${f}")
            if [ -f "${USER_DIR}/.${d}.conf" ]; then
                backed_domains+=("${d}")
            fi
        done
    fi
}

_format_time_label(){
    case "$1" in
        "@midnight") echo "Hang ngay (@midnight)" ;;
        "@weekly")   echo "Hang tuan (@weekly)" ;;
        "@monthly")  echo "Hang thang (@monthly)" ;;
        "@yearly")   echo "Hang nam (@yearly)" ;;
        *)           echo "${1:-Chua ro}" ;;
    esac
}

_domain_cron_info(){
    local d="$1" f="${BASH_DIR}/ggdrive/${1}"
    d_remote=$(grep -w '^remote' "${f}" 2>/dev/null | cut -f2 -d'=')
    d_time=$(grep -w '^time' "${f}" 2>/dev/null | cut -f2 -d'=')
    d_num=$(grep -w '^backup_num' "${f}" 2>/dev/null | cut -f2 -d'=')
    if [ -z "${d_time}" ]; then
        d_time=$(crontab -l 2>/dev/null | grep -E "gg_drive_one([[:space:]]+${d})?([[:space:]]|>|$)" | head -1 | awk '{print $1}')
    fi
    [ -z "${d_remote}" ] && d_remote=$(grep -w "remote" "${FILE_INFO}" 2>/dev/null | cut -f2 -d'=')
    [ -z "${d_num}" ] && d_num=$(grep -w "backup_num" "${FILE_INFO}" 2>/dev/null | cut -f2 -d'=')
}

_select_domain_backup(){
    domain=""
    if [[ "$(ls -A "${USER_DIR}")" ]]; then
        _get_backed_up_domains
        if [ "${#backed_domains[@]}" -gt 0 ]; then
            printf "${GREEN}Ten mien da tao backup:${NC}\n"
            for bd in "${backed_domains[@]}"; do
                _domain_cron_info "${bd}"
                printf "  - %s (%s, luu %s ngay, remote: %s)\n" "${bd}" "$(_format_time_label "${d_time}")" "${d_num:-?}" "${d_remote:-?}"
            done
            echo "----------------------------------------------"
        fi
        domains=()
        _cd_dir "${USER_DIR}"
        for entry_domain in .*.conf; do
            local d=${entry_domain/.}
            d=${d//.conf}
            if [ "${d}" != '*' ] && [ ! -f "${BASH_DIR}/ggdrive/${d}" ]; then
                domains+=("${d}")
            fi
        done
        if [ "${#domains[@]}" -eq 0 ]; then
            ALERT=$(printf "%s\n" "${GREEN}Tat ca ten mien tren VPS deu da duoc tao backup truoc do.${NC}")
            return
        fi
        echo "${LIST_DOMAIN}"
        PS3="${INPUT_SELECT} [0 = Thoat]: "
        select opt_domain in "${domains[@]}"
        do
            domain=$opt_domain
            break
        done
    else
        ALERT=$(printf "%s\n" "${RED}${EMPTY_DOMAIN}${NC}")
    fi
}

_list_backed_up_domains(){
    clear
    printf "%s==============================================%s\n" "${GREEN}" "${NC}"
    printf "%s     Danh sach ten mien da tao backup         %s\n" "${GREEN}" "${NC}"
    printf "%s==============================================%s\n" "${GREEN}" "${NC}"
    local cron_all
    cron_all=$(crontab -l 2>/dev/null | grep -w 'gg_drive_all')
    if [ -n "${cron_all}" ]; then
        local all_remote all_time all_num
        all_remote=$(grep -w "remote" "${FILE_INFO}" 2>/dev/null | cut -f2 -d'=')
        all_time=$(echo "${cron_all}" | awk '{print $1}')
        all_num=$(grep -w "backup_num" "${FILE_INFO}" 2>/dev/null | cut -f2 -d'=')
        printf "Che do         : ${GREEN}Backup toan bo ten mien (gg_drive_all)${NC}\n"
        printf "Lich chay      : ${GREEN}%s (luu %s ngay, remote: %s)${NC}\n" "$(_format_time_label "${all_time}")" "${all_num:-?}" "${all_remote:-?}"
        printf "%s----------------------------------------------%s\n" "${GREEN}" "${NC}"
    fi
    _get_backed_up_domains
    if [ "${#backed_domains[@]}" -eq 0 ]; then
        if [ -z "${cron_all}" ]; then
            printf "%s\n" "${RED}Chua co ten mien nao duoc tao backup theo ten mien.${NC}"
        else
            printf "%s\n" "${GREEN}Dang backup tat ca ten mien tren VPS.${NC}"
        fi
        printf "%s==============================================%s\n" "${GREEN}" "${NC}"
        echo ""
        return
    fi

    local i=1
    for d in "${backed_domains[@]}"; do
        _domain_cron_info "${d}"
        printf "${GREEN}%d.${NC} %-25s | Lich: %-22s | Luu: %s ngay | Remote: %s\n" \
            "${i}" "${d}" "$(_format_time_label "${d_time}")" "${d_num:-?}" "${d_remote:-?}"
        i=$((i + 1))
    done
    printf "%s==============================================%s\n" "${GREEN}" "${NC}"
    read -r -p "Nhap STT ten mien muon xoa khoi danh sach backup [Enter / 0 = Quay lai]: " del_idx
    if [[ -n "${del_idx}" && "${del_idx}" != "0" ]]; then
        if [[ "${del_idx}" =~ ^[0-9]+$ ]] && [ "${del_idx}" -ge 1 ] && [ "${del_idx}" -le "${#backed_domains[@]}" ]; then
            local del_domain="${backed_domains[$((del_idx - 1))]}"
            rm -f "${BASH_DIR}/ggdrive/${del_domain}"
            crontab -u root -l 2>/dev/null | grep -vE "gg_drive_one[[:space:]]+${del_domain}([[:space:]]|>|$)" > backupgg
            _get_backed_up_domains
            if [ "${#backed_domains[@]}" -eq 0 ]; then
                grep -v 'gg_drive_one' backupgg > backupgg.tmp && mv backupgg.tmp backupgg
            fi
            crontab backupgg
            rm -f backupgg
            clear
            printf "${GREEN}Da xoa %s khoi danh sach backup.${NC}\n\n" "${del_domain}"
        else
            clear
            printf "%s\n\n" "${RED}Lua chon khong chinh xac.${NC}"
        fi
    else
        clear
    fi
}

_select_time(){
    echo "Lua chon thoi gian ?"
    PS3='Nhap lua chon cua ban (1-4): '
    options=("Backup 1 lan/ngay" "Backup 1 lan/tuan" "Backup 1 lan/thang" "Backup 1 lan/nam" "Huy tao cronjob")
    select opt in "${options[@]}"
    do
        case $opt in
            "Backup 1 lan/ngay") time="@midnight"; break;;
            "Backup 1 lan/tuan") time="@weekly"; break;;
            "Backup 1 lan/thang") time="@monthly"; break;;
            "Backup 1 lan/nam") time="@yearly"; break;;
            "Huy tao cronjob") time="0"; break;;
            *) printf "%s\n" "${RED}Ban nhap sai, vui long nhap lai.${NC}";;
        esac
    done
}

_input_backup_num(){
    echo "Nhap so ban backup ban muon luu tru: "
    echo "VD: Backup hang ngay va nhap 14 - Se luu backup 14 ngay gan nhat - Cac ban cu hon se bi xoa"
    echo "VD: Backup hang tuan va nhap 3 - Se luu backup 3 tuan gan nhat - Cac ban cu hon se bi xoa"
    while true
    do
        read -r -p "Nhap vao lua chon cua ban [0 = Thoat]:" backup_num
        echo
        if [[ "${backup_num}" =~ ^[0-9]+$ ]]; then
            break
        else
            printf "%s\n"  "${RED}Gia tri khong chinh xac. Vui long nhap lai.${NC}"
        fi
    done
}

_set_backup_time(){
    _input_backup_num
    if [[ "${time}" == "@weekly" ]]; then
        backup_num=$((backup_num*7))
    elif [[ "${time}" == "@monthly" ]]; then
        backup_num=$((backup_num*30))
    elif [[ "${time}" == "@yearly" ]]; then
        backup_num=$((backup_num*365))
    else
        backup_num="${backup_num}"
    fi
}

_delete_old_backup_cron(){
    cron_local_backup=$(crontab -l | grep -w 'backup_local')
    if [ -n "${cron_local_backup}" ]; then
        crontab -u root -l | grep -v "${cron_local_backup}" | crontab -u root -
    fi

    cron_backup_onedrive_all=$(crontab -l | grep -w 'backup_onedrive_all')
    if [ -n "${cron_backup_onedrive_all}" ]; then
        crontab -u root -l | grep -v "${cron_backup_onedrive_all}" | crontab -u root -
    fi

    backup_onedrive_one=$(crontab -l | grep -w 'backup_onedrive_one')
    if [ -n "${backup_onedrive_one}" ]; then
        crontab -u root -l | grep -v "${backup_onedrive_one}" | crontab -u root -
    fi
}

_create_cron_backup_all(){
    _delete_old_backup_cron
    sed -i '/backup_num=/d' "${FILE_INFO}"
    echo "backup_num=${backup_num}" >> "${FILE_INFO}"
    sed -i '/remote/d' "${FILE_INFO}"
    echo "remote=${remote}" >> "${FILE_INFO}"
    crontab -u root -l 2>/dev/null | grep -v 'gg_drive_one' | grep -v 'gg_drive_all' > backupgg
    echo "${time} bash /var/hostvn/menu/cronjob/gg_drive_all >/dev/null 2>&1" >> backupgg
    crontab backupgg
    rm -rf backupgg
}

_create_cron_backup_one(){
    _delete_old_backup_cron
    local legacy_line legacy_time
    legacy_line=$(crontab -u root -l 2>/dev/null | grep -E 'gg_drive_one[[:space:]]+>' | head -1)
    legacy_time=$(echo "${legacy_line}" | awk '{print $1}')

    crontab -u root -l 2>/dev/null \
        | grep -v 'gg_drive_all' \
        | grep -vE 'gg_drive_one[[:space:]]+>' \
        | grep -vE "gg_drive_one[[:space:]]+${domain}([[:space:]]|>|$)" > backupgg

    # Chuyen cac ten mien cu (dung chung 1 dong gg_drive_one khong tham so) sang dong cron rieng
    if [ -n "${legacy_time}" ] && [ -d "${BASH_DIR}/ggdrive" ]; then
        for f in "${BASH_DIR}"/ggdrive/*; do
            [ -f "${f}" ] || continue
            local old_d
            old_d=$(basename "${f}")
            [ "${old_d}" == "${domain}" ] && continue
            if ! grep -qE "gg_drive_one[[:space:]]+${old_d}([[:space:]]|>|$)" backupgg 2>/dev/null; then
                local old_t
                old_t=$(grep -w '^time' "${f}" 2>/dev/null | cut -f2 -d'=')
                [ -z "${old_t}" ] && old_t="${legacy_time}"
                echo "${old_t} bash /var/hostvn/menu/cronjob/gg_drive_one ${old_d} >/dev/null 2>&1" >> backupgg
            fi
        done
    fi

    echo "${time} bash /var/hostvn/menu/cronjob/gg_drive_one ${domain} >/dev/null 2>&1" >> backupgg
    crontab backupgg
    rm -rf backupgg
}

_backup_one(){
    _select_domain_backup
    if [[ -z "${domain}" && -z "${ALERT}" ]]; then
        clear
        printf "%s\n" "${RED}Ban da chon huy thao tac.${NC}"
    else
        if [ -z "${ALERT}" ]; then
            _select_time
            if [ "${time}" == "0" ]; then
                clear
                printf "%s\n" "${RED}Huy tao cronjob.${NC}"
            else
                _set_backup_time
                if [ "${backup_num}" == "0" ]; then
                    clear
                    printf "%s\n" "${RED}Huy tao cronjob.${NC}"
                else
                    if [ ! -d "${BASH_DIR}/ggdrive" ]; then
                        mkdir -p "${BASH_DIR}/ggdrive"
                    fi
                    cat > "${BASH_DIR}/ggdrive/${domain}" <<EOF
remote=${remote}
time=${time}
backup_num=${backup_num}
EOF
                    _create_cron_backup_one
                    clear
                    printf "%s\n" "${GREEN}Tao cronjob thanh cong cho ${domain} (${time}).${NC}"
                    echo ""
                fi
            fi
        else
            clear
            printf "%s\n" "${ALERT}"
        fi
    fi
}

_backup_all(){
    _select_time
    if [ "${time}" == "0" ]; then
        clear
        printf "%s\n" "${RED}Huy tao cronjob.${NC}"
    else
        _set_backup_time
        if [ "${backup_num}" == "0" ]; then
            clear
            printf "%s\n" "${RED}Huy tao cronjob.${NC}"
        else
            sed -i '/remote/d' "${FILE_INFO}"
            echo "remote=${remote}" >> "${FILE_INFO}"
            _create_cron_backup_all
            clear
            printf "%s\n" "${GREEN}Tao cronjob thanh cong.${NC}"
            echo ""
        fi
    fi
}

_run(){
    _select_type
    if [ "${type}" == "0" ]; then
        clear
        printf "%s\n" "${RED}Huy tao cronjob.${NC}"
    elif [ "${type}" == "list" ]; then
        _list_backed_up_domains
    else
        _select_remote
        if [[ -z "${remote}" ]]; then
            clear
            printf "%s\n" "${RED}Ban da huy thao tac.${NC}"
        elif [ "${type}" == "one" ]; then
            _backup_one
        else
            _backup_all
        fi
    fi
}

ALERT=""
time=""
backup_num=""
domain=""
type=""
remote_name=""
backed_domains=()

# Kiem tra co remote Google Drive (type=drive) trong rclone.conf khong
_has_drive_remote() {
    local conf="/root/.config/rclone/rclone.conf"
    [ -f "${conf}" ] || return 1
    grep -q "type = drive" "${conf}" 2>/dev/null || grep -q "type=drive" "${conf}" 2>/dev/null
}

if _has_drive_remote; then
    _run
else
    clear
    printf "%s\n" "${RED}Ban chua ket noi Google Drive.${NC}"
    printf "%s\n" "Vui long vao Menu 8 -> 4 (Ket noi Google Drive) de thiet lap truoc."
    printf "%s\n" "Sau khi ket noi thanh cong, quay lai day de tao cronjob."
fi

menu_cronjob

