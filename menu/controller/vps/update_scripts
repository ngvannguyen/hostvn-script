source /var/hostvn/menu/validate/rule
source /var/hostvn/menu/helpers/function

_set_var(){
    new_v=$(curl -fsS --max-time 15 "${UPDATE_LINK}/version?t=$(date +%s)" 2>/dev/null | grep "^script_version=" | cut -f2 -d'=')
    current_v=$(grep -w "script_version" "${FILE_INFO}" | cut -f2 -d'=');
}

_check_update(){
    if [ -z "${new_v}" ]; then
        ALERT=$(printf "%s\n" "${RED}Loi: Khong the kiem tra phien ban moi tu ${UPDATE_LINK}.${NC}")
    elif [[ "${new_v}" == "${current_v}" ]]; then
        ALERT=$(printf "%s\n" "${RED}Ban dang su dung phien ban moi nhat.${NC}")
    fi
}

_confirm_update(){
    printf "${RED}%s${NC}\n" "Da phat hien phien ban moi."

    while true
    do
        read -r -p "Ban co muon cap nhat ${AUTHOR} Script khong ? (y/n) " prompt_update
        echo
        if [[ "${prompt_update}" =~ ^([yY])$ || "${prompt_update}" =~ ^([nN])$ ]]; then
            break
        else
            clear
            printf "%s\n"  "${RED}Lua chon khong chinh xac. Vui long chon lai.${NC}"
        fi
    done
}

_update(){
    if [[ ! -f "/usr/bin/dos2unix" ]]; then
        apt -y install dos2unix
    fi
    _cd_dir "${BASH_DIR}"
    rm -f update.tmp
    if ! curl -fsS --max-time 30 -o update.tmp "${UPDATE_LINK}/update?t=$(date +%s)"; then
        rm -f update.tmp
        clear
        printf "${RED}%s${NC}\n" "Loi: Khong the tai file update tu ${UPDATE_LINK}. Giu nguyen phien ban hien tai."
        sleep 3
        return 1
    fi
    dos2unix update.tmp >/dev/null 2>&1
    if ! bash -n update.tmp; then
        rm -f update.tmp
        clear
        printf "${RED}%s${NC}\n" "Loi: File update tai ve co loi cu phap (bash -n). Huy cap nhat de bao ve he thong."
        sleep 3
        return 1
    fi
    chmod +x update.tmp
    bash update.tmp
    update_exit_code=$?
    rm -f update.tmp
    clear
    if [ "${update_exit_code}" -eq 0 ] && nginx -t >/dev/null 2>&1; then
        printf "%s\n" "${GREEN}Update ${AUTHOR} Script thanh cong.${NC}"
        printf "%s\n" "${RED}Script se tu dong thoat menu de ap dung update...${NC}"
    else
        printf "${RED}%s${NC}\n" "Loi: Qua trinh cap nhat that bai (ma loi=${update_exit_code})!"
        printf "${RED}%s${NC}\n" "He thong da giu nguyen hoac tu dong rollback cau hinh truoc do. Kiem tra log phia tren."
    fi
    sleep 3
    exit
}

_run(){
    _set_var
    _check_update

    if [ -z "${ALERT}" ]; then
        _confirm_update
        if [[ "${prompt_update}" =~ ^([yY])$ ]]; then
            _update
        else
            clear
            printf "%s\n" "${GREEN}Ban da huy update ${AUTHOR} Script${NC}"
        fi

    else
        clear
        printf "%s\n" "${ALERT}"
    fi
}

ALERT=""
prompt_update=""

_run
