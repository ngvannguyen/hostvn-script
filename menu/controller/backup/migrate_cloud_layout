#!/bin/bash

######################################################################
#   Migrate Cloud Backup Layout: <IP>/<date>/<domain>                #
#                            --> <IP>/<domain>/<date>                #
#   Chay doc lap 1 lan:                                              #
#     bash /var/hostvn/menu/controller/backup/migrate_cloud_layout   #
######################################################################

source /var/hostvn/ipaddress
source /var/hostvn/.hostvn.conf
source /var/hostvn/menu/helpers/variable_common
source /var/hostvn/menu/helpers/function

# Khoa chung voi cron backup de khong xung dot khi dang di chuyen du lieu
exec 9>/var/lock/hostvn_cloud_backup.lock
if ! flock -n 9; then
    printf "${RED}%s${NC}\n" "Dang co tien trinh backup khac chay. Vui long doi backup xong roi chay lai."
    exit 1
fi

printf "%s\n" "${GREEN}=== Chuyen doi cau truc backup Cloud (<IP>/<ngay>/<domain> -> <IP>/<domain>/<ngay>) ===${NC}"
echo
echo "Chon loai remote can xu ly:"
PS3="Nhap lua chon [1-3]: "
loc=""
select opt_loc in "Google Drive / S3 / remote khac" "OneDrive" "Thoat"; do
    case "${opt_loc}" in
    "Google Drive / S3 / remote khac") loc="drive"; break ;;
    "OneDrive") loc="onedrive"; break ;;
    "Thoat") exit 0 ;;
    *) printf "${RED}%s${NC}\n" "Lua chon khong hop le." ;;
    esac
done

remote=""
remote_base=""
if [ "${loc}" = "onedrive" ]; then
    remote="onedrive"
    onedrive_folder_name=$(grep -w "onedrive_folder_name" "${FILE_INFO}" | cut -f2 -d'=')
    remote_base="${onedrive_folder_name}/${IPADDRESS}"
else
    _select_remote
    [ -z "${remote}" ] && exit 0
    remote_base="${IPADDRESS}"
fi

if ! rclone listremotes 2>/dev/null | grep -qx "${remote}:"; then
    printf "${RED}%s${NC}\n" "Remote '${remote}' khong ton tai trong rclone config."
    exit 1
fi

echo
printf "%s\n" "Dich dang chon: ${GREEN}${remote}:${remote_base}${NC}"
echo "Chon phuong an xu ly backup cu:"
echo "  1. Doi ten thu muc <IP> cu thanh <IP>_legacy_${CURRENT_DATE} (Nhanh 1 giay, 0 rui ro, khuyen dung khi > 20 domain)"
echo "  2. Di chuyen server-side tung <ngay>/<domain> sang <domain>/<ngay> (Khong ton bang thong VPS, co dry-run xem truoc)"
echo "  0. Thoat"
read -r -p "Nhap lua chon [0-2]: " mode

case "${mode}" in
1)
    target_legacy="${remote_base}_legacy_${CURRENT_DATE}"
    if rclone lsf "${remote}:${target_legacy}" >/dev/null 2>&1; then
        target_legacy="${remote_base}_legacy_${CURRENT_DATE}_$(date +%H%M%S)"
    fi
    echo
    printf "%s\n" "Se doi ten: ${remote}:${remote_base}  -->  ${remote}:${target_legacy}"
    read -r -p "Xac nhan thuc hien? (y/n): " confirm
    [[ "${confirm}" =~ ^[yY]$ ]] || { echo "Da huy."; exit 0; }

    if rclone moveto "${remote}:${remote_base}" "${remote}:${target_legacy}"; then
        printf "${GREEN}%s${NC}\n" "Thanh cong! Ban backup cu nam tai: ${remote}:${target_legacy}"
        printf "%s\n" "Thu muc ${remote}:${remote_base} da san sang cho luong backup moi (<IP>/<domain>/<ngay>)."
    else
        printf "${RED}%s${NC}\n" "Doi ten that bai. Kiem tra ket noi remote hoac quyen ghi."
        exit 1
    fi
    ;;
2)
    echo
    printf "%s\n" "Dang quet cac thu muc ngay cu tai ${remote}:${remote_base}..."
    mapfile -t legacy_dates < <(rclone lsf --dirs-only "${remote}:${remote_base}" 2>/dev/null | sed 's|/$||' | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}' | sort)
    if [ ${#legacy_dates[@]} -eq 0 ]; then
        printf "${GREEN}%s${NC}\n" "Khong tim thay thu muc ngay cu nao (<YYYY-MM-DD>). Khong can migrate."
        exit 0
    fi

    # Lap danh sach cap (ngay|domain) can chuyen
    pairs=()
    for d in "${legacy_dates[@]}"; do
        while IFS= read -r dom; do
            dom=${dom%/}
            [ -z "${dom}" ] && continue
            pairs+=("${d}|${dom}")
        done < <(rclone lsf --dirs-only "${remote}:${remote_base}/${d}" 2>/dev/null)
    done

    printf "%s\n" "Tim thay ${#legacy_dates[@]} thu muc ngay cu, tong cong ${#pairs[@]} thu muc backup can di chuyen."
    if [ ${#pairs[@]} -eq 0 ]; then
        printf "%s\n" "Cac thu muc ngay cu deu rong. Co the xoa bang: rclone rmdirs --leave-root \"${remote}:${remote_base}\""
        exit 0
    fi

    echo "--- Xem truoc (toi da 15 muc dau) ---"
    shown=0
    for p in "${pairs[@]}"; do
        d=${p%%|*}
        dom=${p#*|}
        printf "  %s/%s  -->  %s/%s\n" "${d}" "${dom}" "${dom}" "${d}"
        shown=$((shown + 1))
        [ "${shown}" -ge 15 ] && break
    done
    [ ${#pairs[@]} -gt 15 ] && echo "  ... (va $(( ${#pairs[@]} - 15 )) thu muc khac)"
    echo

    read -r -p "Chay thu --dry-run truoc? (y/n): " do_dry
    if [[ "${do_dry}" =~ ^[yY]$ ]]; then
        for p in "${pairs[@]}"; do
            d=${p%%|*}
            dom=${p#*|}
            rclone move --dry-run "${remote}:${remote_base}/${d}/${dom}" "${remote}:${remote_base}/${dom}/${d}"
        done
    fi

    echo
    read -r -p "Xac nhan di chuyen THAT ${#pairs[@]} thu muc (server-side, khong xoa file neu loi)? (y/n): " confirm
    [[ "${confirm}" =~ ^[yY]$ ]] || { echo "Da huy."; exit 0; }

    ok=0
    fail=0
    for p in "${pairs[@]}"; do
        d=${p%%|*}
        dom=${p#*|}
        printf "Dang chuyen %s/%s -> %s/%s ... " "${d}" "${dom}" "${dom}" "${d}"
        if rclone move "${remote}:${remote_base}/${d}/${dom}" "${remote}:${remote_base}/${dom}/${d}" >/dev/null 2>&1; then
            echo "OK"
            ok=$((ok + 1))
        else
            echo "LOI"
            fail=$((fail + 1))
        fi
    done

    # Chi xoa cac thu muc ngay cu da RONG (rmdirs khong bao gio xoa thu muc con file)
    rclone rmdirs --leave-root "${remote}:${remote_base}" >/dev/null 2>&1 || true

    echo
    printf "${GREEN}%s${NC}\n" "Hoan tat: ${ok} thanh cong, ${fail} loi."
    if [ "${fail}" -gt 0 ]; then
        printf "${RED}%s${NC}\n" "Co ${fail} thu muc loi — du lieu goc cua cac muc loi van duoc giu nguyen, co the chay lai script."
        exit 1
    fi
    ;;
*)
    echo "Da huy."
    exit 0
    ;;
esac
