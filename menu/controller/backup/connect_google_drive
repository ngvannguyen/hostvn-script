source /var/hostvn/menu/validate/rule
source /var/hostvn/menu/helpers/function

_input() {
    printf "%s\n" "${GREEN}==================================================${NC}"
    printf "%s         HUONG DAN KET NOI GOOGLE DRIVE          ${NC}\n" "${GREEN}"
    printf "%s==================================================${NC}\n" "${GREEN}"
    echo "De ket noi Google Drive khong bi Google block:"
    echo "1. Tao Client ID / Client Secret tren Google Cloud Console (Desktop App)."
    echo "2. Lay Token JSON bang cach chay tren may tinh cua ban:"
    echo "   rclone authorize \"drive\" --drive-client-id \"<CLIENT_ID>\" --drive-client-secret \"<CLIENT_SECRET>\""
    echo
    
    while true; do
        read -r -p "1. Nhap Remote Name [Default: gdrive, 0 = Thoat]: " remote_name
        remote_name="${remote_name:-gdrive}"
        if [ "${remote_name}" == "0" ]; then return 1; fi
        if validate_user "${remote_name}"; then break; fi
        printf "%s\n" "${RED}${lang_wrong_format}${NC}"
    done

    while true; do
        read -r -p "2. Nhap Google Client ID: " client_id
        if [ -n "${client_id}" ]; then break; fi
        printf "%s\n" "${RED}Client ID khong duoc de trong!${NC}"
    done

    while true; do
        read -r -p "3. Nhap Google Client Secret: " client_secret
        if [ -n "${client_secret}" ]; then break; fi
        printf "%s\n" "${RED}Client Secret khong duoc de trong!${NC}"
    done

    while true; do
        echo
        echo "4. Dan doan Token JSON (chuoi {\"access_token\":...} thu duoc sau khi dang nhap):"
        read -r -p "   Token JSON: " config_token
        if [ -n "${config_token}" ]; then break; fi
        printf "%s\n" "${RED}Token JSON khong duoc de trong!${NC}"
    done

    return 0
}

_config_rclone() {
    rclone_config_file="/root/.config/rclone/rclone.conf"
    if [ -f "${rclone_config_file}" ] && grep -wq "${remote_name}" "${rclone_config_file}"; then
        clear
        printf "%s\n" "${RED}Remote Name '${remote_name}' da ton tai. Vui long chon ten khac.${NC}"
        return 1
    fi

    if rclone config create "${remote_name}" drive client_id "${client_id}" client_secret "${client_secret}" config_token "${config_token}" scope drive use_trash false >/dev/null 2>&1; then
        clear
        printf "%s\n" "${GREEN}Ket noi Google Drive '${remote_name}' thanh cong!${NC}"
    else
        clear
        printf "%s\n" "${RED}Tao ket noi Google Drive that bai. Vui long kiem tra lai Token JSON.${NC}"
    fi
}

if _input; then
    _config_rclone
fi

menu_backup
