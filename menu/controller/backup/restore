source /var/hostvn/menu/validate/rule
source /var/hostvn/menu/helpers/function

_select_backup_location() {
    clear
    printf "%s\n" "Lua chon noi luu backup"
    PS3="Nhap vao lua chon cua ban [ 1 - 4 ]: "
    # "Cloud" gom Google Drive VA moi remote rclone khac (S3/MinIO/Backblaze...)
    # vi buoc sau dung _select_remote liet ke tat ca. Truoc day nhan chi ghi
    # "Google Drive" nen nguoi dung tuong khong khoi phuc duoc tu S3.
    location_options=("VPS (Local)" "Cloud (Google Drive / S3 / remote khac)" "OneDrive" "Cancel")
    select opt_location in "${location_options[@]}"; do
        case $opt_location in
        "VPS (Local)")
            location="local"
            break
            ;;
        "Cloud (Google Drive / S3 / remote khac)")
            location="drive"
            break
            ;;
        "OneDrive")
            location="onedrive"
            break
            ;;
        "Cancel")
            location="cancel"
            break
            ;;
        *) printf "${RED}%s${NC}\n" "Lua chon cua ban khong chinh xac. Vui long chon lai. $REPLY" ;;
        esac
    done
}

_selection_restore_type() {
    clear
    printf "%s\n" "Lua chon kieu khoi phuc du lieu"
    PS3="Nhap vao lua chon cua ban [ 1 - 4 ]: "
    type_options=("Khoi phuc full (Source + DB)" "Khoi phuc ma nguon" "Khoi phuc Database" "Cancel")
    select opt_type in "${type_options[@]}"; do
        case $opt_type in
        "Khoi phuc full (Source + DB)")
            type="full"
            break
            ;;
        "Khoi phuc ma nguon")
            type="source"
            break
            ;;
        "Khoi phuc Database")
            type="database"
            break
            ;;
        "Cancel")
            type="cancel"
            break
            ;;
        *) printf "${RED}%s${NC}\n" "Lua chon cua ban khong chinh xac. Vui long chon lai. $REPLY" ;;
        esac
    done
}

_create_drive_connect() {
    clear
    printf "%s\n" "${RED}Ban chua cau hinh ket noi voi Google Drive.${NC}"
    prompt_connect_drive="n"
    echo "Ban co muon cau hinh ket noi voi Google Drive khong ?"
    PS3='Nhap lua chon cua ban (1-2): '
    options=("Yes" "No")
    select opt in "${options[@]}"; do
        case $opt in
        "Yes")
            prompt_connect_drive="y"
            break
            ;;
        "No")
            prompt_connect_drive="n"
            break
            ;;
        *) printf "%s\n" "${RED}Ban nhap sai, vui long nhap lai.${NC}" ;;
        esac
    done

    if [[ "${prompt_connect_drive}" =~ ^([yY])$ ]]; then
        while true; do
            echo "Ten ket noi khong chua ky tu dac biet va dai 5 ky tu tro len."
            read -r -p "Nhap vao ten ket noi muon tao (Viet lien, khong dau) [0 = Thoat]: " remote_name
            echo
            if validate_user "${remote_name}" || [ "${remote_name}" == "0" ]; then
                break
            else
                printf "%s\n" "${RED}Ten ket noi khong dung dinh dan. Vui long nhap lai.${NC}"
            fi
        done

        if [ "${remote_name}" == "0" ]; then
            clear
            printf "%s\n" "${RED}Huy hanh dong.${NC}"
        else
            source /var/hostvn/menu/controller/backup/connect_google_drive
            clear
            _run
        fi
    else
        clear
        printf "${RED}%s${NC}\n" "Huy thao tac."
    fi
}

_conditions() {
    if ! check_backup_exists "${date}" "${domain}"; then
        ALERT="Ten mien nay khong co backup."
    fi

    if ! check_backup_empty "${date}" "${domain}"; then
        ALERT="Ten mien nay khong co backup."
    fi

    if [[ "${type}" == "source" || "${type}" == "full" ]]; then
        if [ ! -f "/home/backup/${date}/${domain}/${domain}.tar.gz" ]; then
            ALERT="Ten mien nay khong co backup ma nguon."
        fi
    fi

    if [[ "${type}" == "full" ]]; then
        if [[ ! -f "/home/backup/${date}/${domain}/${db_name}.sql.gz" && ! -f "/home/backup/${date}/${domain}/${db_name}.sql" ]]; then
            ALERT="Ten mien nay khong co backup database."
        fi
    fi
}

_sql_list() {
    sql_files=()
    for entry in *.{sql,sql.gz}; do
        if [ -f "${entry}" ]; then
            sql_files+=("${entry}")
        fi
    done

    echo "Chon file database muon khoi phuc"
    PS3="Nhap vao lua chon cua ban [0 = Thoat]: "
    select opt in "${sql_files[@]}"; do
        sql=$opt
        break
    done
}

_import_database() {
    if [[ ${sql} == *"sql.gz"* ]]; then
        sql_file=$(echo "${sql}" | cut -f1 -d'.')
        gzip -d "${sql}"
        mysql -uadmin -p"${mysql_pwd}" "${db_name}" <  "${sql_file}".sql
    else
        mysql -uadmin -p"${mysql_pwd}" "${db_name}" < "${sql}"
    fi
}

_decompress_source() {
    if [[ ! -d "/home/${user}/${domain}/public_html" ]]; then
        mkdir -p /home/"${user}"/"${domain}"/public_html
    fi
    _cd_dir /home/backup/"${date}"/"${domain}"
    rm -rf /home/"${user}"/"${domain}"/public_html/*
    tar xvzf /home/backup/"${date}"/"${domain}"/"${domain}".tar.gz -C /home/"${user}"/"${domain}"/
    chmod 711 /home
    chmod 755 /home/"${user}"
    chmod 711 /home/"${user}"/"${domain}"
    chmod 711 /home/"${user}"/"${domain}"/logs
    chmod 755 /home/"${user}"/"${domain}"/public_html
    find /home/"${user}"/"${domain}"/public_html/ -type d -print0 | xargs -I {} -0 chmod 0755 {}
    find /home/"${user}"/"${domain}"/public_html/ -type f -print0 | xargs -I {} -0 chmod 0644 {}
    chown root:root /home/"${user}"
    chown -R "${user}":"${user}" /home/"${user}"/"${domain}"
    chown -R "${user}":"${user}" /home/"${user}"/tmp
    chown -R "${user}":"${user}" /home/"${user}"/php
}

# Duong dan goc chua backup tren remote.
# Cau truc moi : <remote>:<remote_base>/<domain>/<ngay>
# Cau truc cu  : <remote>:<remote_base>/<ngay>/<domain> (tu dong ho tro khi khoi phuc)
_set_remote_base() {
    if [ "${location}" == "onedrive" ]; then
        remote="onedrive"
        onedrive_folder_name=$(grep -w "onedrive_folder_name" "${FILE_INFO}" | cut -f2 -d'=')
        remote_base="${onedrive_folder_name}/${IPADDRESS}"
    else
        remote_base="${IPADDRESS}"
    fi
}

_select_drive_backup_domain() {
    clear
    echo "Chon ten mien ban muon khoi phuc: "
    all_domains=()
    legacy_dates=()
    use_index="no"
    domain=""

    local root_entries entry dm domain_filter
    root_entries=$(rclone lsf --dirs-only "${remote}:${remote_base}" 2>/dev/null)
    if [ -n "${root_entries}" ]; then
        while IFS= read -r entry; do
            entry=${entry%/}
            [ -z "${entry}" ] && continue
            if [[ "${entry}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
                legacy_dates+=("${entry}")
            else
                all_domains+=("${entry}")
            fi
        done <<< "${root_entries}"

        # Neu con thu muc backup cu (<ngay>/<domain>), gop them danh sach domain tren VPS de de tim
        if [ ${#legacy_dates[@]} -gt 0 ]; then
            for entry_conf in "${USER_DIR}"/.*.conf; do
                [ -f "${entry_conf}" ] || continue
                dm=$(basename "${entry_conf}"); dm=${dm#.}; dm=${dm%.conf}
                [ "${dm}" != '*' ] && all_domains+=("${dm}")
            done
        fi
        if [ ${#all_domains[@]} -gt 0 ]; then
            mapfile -t all_domains < <(printf '%s\n' "${all_domains[@]}" | grep -v '^$' | sort -u)
        fi
    else
        # Remote khong liet ke duoc theo prefix (gateway S3). Doc so muc luc do hostvn ghi.
        printf "%s\n" "${GREEN}Remote nay khong liet ke duoc thu muc — dang doc so muc luc backup...${NC}"
        backup_index_fetch "${remote}" >/dev/null 2>&1
        mapfile -t all_domains < <(backup_index_all_domains "${remote}")
        if [ ${#all_domains[@]} -gt 0 ]; then
            use_index="yes"
        else
            use_index="manual"
            for entry_conf in "${USER_DIR}"/.*.conf; do
                [ -f "${entry_conf}" ] || continue
                dm=$(basename "${entry_conf}"); dm=${dm#.}; dm=${dm%.conf}
                [ "${dm}" != '*' ] && all_domains+=("${dm}")
            done
        fi
    fi

    if [ ${#all_domains[@]} -eq 0 ]; then
        printf "%s\n" "${RED}Khong tim thay du lieu backup nao tren remote '${remote}'.${NC}"
        return
    fi

    printf "%s\n" "Tim thay ${#all_domains[@]} ten mien."
    read -r -p "Nhap tu khoa loc ten mien [Enter = hien tat ca]: " domain_filter
    domains=()
    if [ -n "${domain_filter}" ]; then
        mapfile -t domains < <(printf '%s\n' "${all_domains[@]}" | grep -iF -- "${domain_filter}")
        if [ ${#domains[@]} -eq 0 ]; then
            printf "%s\n" "${RED}Khong co ten mien nao khop '${domain_filter}'. Hien thi tat ca:${NC}"
            domains=("${all_domains[@]}")
        fi
    else
        domains=("${all_domains[@]}")
    fi

    PS3="Nhap lua chon cua ban [0 = Thoat]: "
    select domain in "${domains[@]}"; do
        domain=${domain}
        break
    done
}

_select_drive_backup_date() {
    clear
    echo "Chon ngay backup cua ten mien ${domain}: "
    dates=()
    backup_layout="new"
    date=""
    local legacy_opt="[Tim trong backup cu (<ngay>/<domain>)]"

    if [ "${use_index}" == "no" ]; then
        mapfile -t dates < <(rclone lsf --dirs-only "${remote}:${remote_base}/${domain}" 2>/dev/null | sed 's|/$||' | grep -v '^$' | sort -ru)
        if [ ${#dates[@]} -eq 0 ] && [ ${#legacy_dates[@]} -gt 0 ]; then
            printf "%s\n" "${GREEN}Dang tim ban backup theo cau truc cu (<ngay>/${domain})...${NC}"
            mapfile -t dates < <(rclone lsf --dirs-only --max-depth 2 "${remote}:${remote_base}" --include "*/${domain}/" 2>/dev/null | awk -F'/' -v d="${domain}" '$2 == d { print $1 }' | sort -ru)
            backup_layout="legacy"
        elif [ ${#legacy_dates[@]} -gt 0 ]; then
            dates+=("${legacy_opt}")
        fi
    elif [ "${use_index}" == "yes" ]; then
        mapfile -t dates < <(backup_index_domain_dates "${remote}" "${domain}")
    fi

    if [ ${#dates[@]} -eq 0 ]; then
        if [ "${use_index}" == "manual" ]; then
            printf "%s\n" "${RED}Khong doc duoc so muc luc tren remote '${remote}'.${NC}"
            printf "%s\n" "Ban co the nhap ngay thu cong (dinh dang YYYY-MM-DD) neu biet chinh xac."
            read -r -p "Nhap ngay backup [Enter = thoat]: " manual_date
            [ -n "${manual_date}" ] && date="${manual_date}"
        else
            printf "%s\n" "${RED}Khong tim thay ban backup nao cua ten mien ${domain}.${NC}"
        fi
        return
    fi

    PS3="Nhap lua chon cua ban [0 = Thoat]: "
    select date in "${dates[@]}"; do
        date=${date}
        break
    done

    if [ "${date}" == "${legacy_opt}" ]; then
        clear
        printf "%s\n" "${GREEN}Dang tim ban backup theo cau truc cu (<ngay>/${domain})...${NC}"
        dates=()
        date=""
        mapfile -t dates < <(rclone lsf --dirs-only --max-depth 2 "${remote}:${remote_base}" --include "*/${domain}/" 2>/dev/null | awk -F'/' -v d="${domain}" '$2 == d { print $1 }' | sort -ru)
        if [ ${#dates[@]} -eq 0 ]; then
            printf "%s\n" "${RED}Khong tim thay ban backup cu nao cua ten mien ${domain}.${NC}"
            return
        fi
        backup_layout="legacy"
        PS3="Nhap lua chon cua ban [0 = Thoat]: "
        select date in "${dates[@]}"; do
            date=${date}
            break
        done
    fi
}

# Dung chung cho Google Drive, S3 va OneDrive — luong chon: Ten mien -> Ngay backup.
_google_drive_action() {
    if [ "${location}" == "onedrive" ]; then
        _set_remote_base
    else
        _select_remote
        _set_remote_base
    fi
    if [ -z "${remote}" ]; then
        ALERT="${RED}Ban da chon huy khoi phuc du lieu.${NC}"
        return
    fi

    _select_drive_backup_domain
    if [[ -z "${domain}" || "${domain}" == "0" ]]; then
        ALERT="${RED}Ban da chon huy khoi phuc du lieu.${NC}"
        return
    fi

    _select_drive_backup_date
    if [[ -z "${date}" || "${date}" == "0" ]]; then
        ALERT="${RED}Ban da chon huy khoi phuc du lieu.${NC}"
        return
    fi

    if [ -d "/home/backup/${date}/${domain}" ]; then
        rm -rf /home/backup/"${date}"/"${domain}"
    fi

    mkdir -p /home/backup/"${date}"/"${domain}"
    user=$(grep -w "username" "${USER_DIR}/.${domain}.conf" 2>/dev/null | cut -f2 -d'=')
    db_name=$(grep -w "db_name" "${USER_DIR}/.${domain}.conf" 2>/dev/null | cut -f2 -d'=')
    clear
    printf "%s\n" "Dang download du lieu (${domain} - ${date}). Vui long doi..."
    if [ "${use_index}" == "no" ]; then
        if [ "${backup_layout}" == "legacy" ]; then
            rclone copy "${remote}:${remote_base}/${date}/${domain}" /home/backup/"${date}"/"${domain}" --bwlimit 30M
        else
            rclone copy "${remote}:${remote_base}/${domain}/${date}" /home/backup/"${date}"/"${domain}" --bwlimit 30M
        fi
    else
        # Remote khong liet ke duoc -> goi copyto cho TUNG file theo duong dan chinh xac.
        # Thu cau truc moi (<domain>/<ngay>) truoc, khong co thi fallback cau truc cu (<ngay>/<domain>).
        bk_files=$(backup_index_files "${remote}" "${date}" "${domain}")
        if [ -z "${bk_files}" ]; then
            db_guess=$(grep -w "db_name" "${USER_DIR}/.${domain}.conf" 2>/dev/null | cut -f2 -d'=')
            bk_files="${domain}.tar.gz"
            [ -n "${db_guess}" ] && bk_files="${bk_files}
${db_guess}.sql.gz"
        fi
        while IFS= read -r bf; do
            [ -z "${bf}" ] && continue
            printf "  tai %s ... " "${bf}"
            if rclone copyto "${remote}:${remote_base}/${domain}/${date}/${bf}" \
                    "/home/backup/${date}/${domain}/${bf}" --bwlimit 30M >/dev/null 2>&1 \
               || rclone copyto "${remote}:${remote_base}/${date}/${domain}/${bf}" \
                    "/home/backup/${date}/${domain}/${bf}" --bwlimit 30M >/dev/null 2>&1; then
                echo "xong"
            else
                echo "khong co / loi"
            fi
        done <<< "${bk_files}"
    fi
}

_restore_source() {
    if [ "${location}" == "local" ]; then
        _list_backup
        if [[ -z "${date}" || -z "${domain}" ]]; then
            clear
            printf "%s\n" "${RED}Ban da chon huy thao tac${NC}"
        else
            user=$(grep -w "username" "${USER_DIR}/.${domain}.conf" | cut -f2 -d'=')
            db_name=$(grep -w "db_name" "${USER_DIR}/.${domain}.conf" | cut -f2 -d'=')
            _conditions
            if [ ! -f "/home/backup/${date}/${domain}/${domain}.tar.gz" ]; then
                ALERT="Ten mien nay khong co backup."
            fi

            if [ -z "${ALERT}" ]; then
                clear
                printf "%s\n" "Dang khoi phuc du lieu. Vui long doi cho toi khi qua trinh hoan tat..."
                _decompress_source
                clear
                printf "%s\n" "${GREEN}Khoi phuc du lieu thanh cong.${NC}"
            else
                clear
                printf "${RED}%s${NC}\n" "${ALERT}"
            fi
        fi
    else
        _google_drive_action
        _conditions
        if [ -z "${ALERT}" ]; then
            _decompress_source
            rm -rf /home/backup/"${date}"/"${domain}"
            clear
            printf "%s\n" "${GREEN}Khoi phuc du lieu thanh cong.${NC}"
        else
            clear
            printf "${RED}%s${NC}\n" "${ALERT}"
        fi
    fi
}

_restore_database() {
    if [ "${location}" == "local" ]; then
        _list_backup
        if [[ -z "${date}" || -z "${domain}" ]]; then
            clear
            printf "%s\n" "${RED}Ban da chon huy thao tac${NC}"
        else
            user=$(grep -w "username" "${USER_DIR}/.${domain}.conf" | cut -f2 -d'=')
            db_name=$(grep -w "db_name" "${USER_DIR}/.${domain}.conf" | cut -f2 -d'=')
            _conditions

            if [ -z "${ALERT}" ]; then
                _cd_dir /home/backup/"${date}"/"${domain}"
                _sql_list
                if [ -z "${sql}" ]; then
                    clear
                    printf "%s\n" "${RED}Ten mien nay khong co backup.${NC}"
                else
                    clear
                    printf "%s\n" "Dang khoi phuc du lieu. Vui long doi cho toi khi qua trinh hoan tat..."
                    _import_database
                    clear
                    printf "%s\n" "${GREEN}Khoi phuc du lieu thanh cong.${NC}"
                fi
            else
                clear
                printf "${RED}%s${NC}\n" "${ALERT}"
            fi
        fi
    else
        _google_drive_action
        _conditions

        if [ -z "${ALERT}" ]; then
            clear
            _cd_dir /home/backup/"${date}"/"${domain}"
            _sql_list
            if [ -z "${sql}" ]; then
                clear
                printf "%s\n" "${RED}Ban da chon huy khoi phuc du lieu.${NC}"
            else
                _import_database
                rm -rf /home/backup/"${date}"/"${domain}"
                clear
                printf "%s\n" "${GREEN}Khoi phuc du lieu thanh cong.${NC}"
            fi
        else
            clear
            printf "%s\n" "${ALERT}"
        fi
    fi
}

_restore_full() {
    clear
    if [ "${location}" == "local" ]; then
        _list_backup
        if [[ -z "${date}" || -z "${domain}" ]]; then
            clear
            printf "%s\n" "${RED}Ban da chon huy thao tac${NC}"
        else
            user=$(grep -w "username" "${USER_DIR}/.${domain}.conf" | cut -f2 -d'=')
            db_name=$(grep -w "db_name" "${USER_DIR}/.${domain}.conf" | cut -f2 -d'=')
            _conditions

            if [ -z "${ALERT}" ]; then
                clear
                printf "%s\n" "Dang khoi phuc du lieu. Vui long doi cho toi khi qua trinh hoan tat..."
                _decompress_source
                _cd_dir /home/backup/"${date}"/"${domain}"
                gzip -d "${db_name}".sql.gz
                mysql -uadmin -p"${mysql_pwd}" "${db_name}" <"${db_name}".sql
                gzip -9 "${db_name}".sql
                clear
                printf "%s\n" "${GREEN}Khoi phuc du lieu thanh cong.${NC}"
            else
                clear
                printf "${RED}%s${NC}\n" "${ALERT}"
            fi
        fi
    else
        _google_drive_action
        _conditions
        if [ -z "${ALERT}" ]; then
            _decompress_source
            _cd_dir /home/backup/"${date}"/"${domain}"
            gzip -d "${db_name}".sql.gz
            mysql -uadmin -p"${mysql_pwd}" "${db_name}" <"${db_name}".sql
            rm -rf /home/backup/"${date}"/"${domain}"
            printf "%s\n" "${GREEN}Khoi phuc du lieu thanh cong.${NC}"
        else
            clear
            printf "${RED}%s${NC}\n" "${ALERT}"
        fi
    fi
}

_run() {
    clear
    while true; do
        read -r -p "Ban muon khoi phuc du lieu ? (y/n) " prompt_restore
        echo
        if [[ "${prompt_restore}" =~ ^([yY])$ || "${prompt_restore}" =~ ^([nN])$ ]]; then
            break
        else
            printf "%s\n" "${RED}Gia tri khong chinh xac. Vui long nhap lai.${NC}"
        fi
    done

    if [[ "${prompt_restore}" =~ ^([yY])$ ]]; then
        if [ "${type}" = "full" ]; then
            _restore_full
        elif [ "${type}" = "source" ]; then
            _restore_source
        else
            _restore_database
        fi
    else
        clear
        printf "%s\n" "${RED}Ban da huy thao tac.${NC}"
    fi
}

location=""
type=""
remote_name=""
remote=""
remote_base=""
use_index="no"
domain=""
date=""

_select_backup_location

if [[ -z "${location}" || "${location}" == "cancel" ]]; then
    clear
    printf "${RED}%s${NC}\n" "Huy thao tac."
else
    _selection_restore_type
    if [[ -z "${type}" || "${type}" == "cancel" ]]; then
        clear
        printf "${RED}%s${NC}\n" "Huy thao tac."
    else
        if [[ "${location}" =~ ^(drive|onedrive)$ && ! -f "/root/.config/rclone/rclone.conf" ]]; then
            _create_drive_connect
        else
            _run
        fi
    fi
fi

