CHOICE=1

nginx_v=$(
    nginx -v 2>&1 | grep -o '[0-9.]*$'
    echo
)
nginx_status=$(pgrep -x nginx >/dev/null && printf "%s\n" "${GREEN}Active${NC}" || printf "%s\n" "${GREEN}Inactive (Dead)${NC}")

# Tu dong lay phien ban Nginx moi nhat truc tiep tu kho ma nguon nginx.org
_detect_latest_nginx(){
    local ver=""
    ver=$(curl -sL --max-time 10 "https://nginx.org/download/" | grep -oE 'nginx-[0-9]+\.[0-9]+\.[0-9]+\.tar\.gz' | sed 's/nginx-//;s/\.tar\.gz//' | sort -V | tail -n1)
    if [ -z "${ver}" ]; then
        ver=$(curl -sL --max-time 10 "https://nginx.org/en/download.html" | grep -oE 'nginx-[0-9]+\.[0-9]+\.[0-9]+\.tar\.gz' | sed 's/nginx-//;s/\.tar\.gz//' | sort -V | tail -n1)
    fi
    if [ -z "${ver}" ]; then
        ver=$(apt-cache policy nginx 2>/dev/null | awk '/Candidate:/ {print $2}' | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+')
    fi
    if [ -z "${ver}" ]; then
        ver=$(curl -s --max-time 10 "${UPDATE_LINK}"/version | grep "^nginx_version=" | cut -f2 -d'=')
    fi
    [ -z "${ver}" ] && [ -f "/var/hostvn/version" ] && ver=$(grep "^nginx_version=" /var/hostvn/version | cut -f2 -d'=')
    echo "${ver:-${NGINX_CURRENT_VERSION:-1.30.6}}"
}

# Build Nginx tu source voi PCRE2 + OpenSSL 3 cua he thong
# (libpcre3/OpenSSL 1.1.1 da bi go khoi Ubuntu 24.04+)
_build_nginx(){
    local NGINX_BUILD_VERSION="$1"
    if [ -z "${NGINX_BUILD_VERSION}" ]; then
        printf "%s\n" "${RED}Chua xac dinh phien ban Nginx can build.${NC}"
        return 1
    fi

    MODULE_PATH="/usr/share/nginx_module"
    mkdir -p "${MODULE_PATH}"
    apt-get install build-essential zlib1g-dev libpcre2-dev libssl-dev libbrotli-dev unzip uuid-dev git -y

    # Lay version module: uu tien /var/hostvn/version, fallback remote, cuoi cung la gia tri mac dinh on dinh
    local ngx_cache_purge_version more_clear_headers_v nginx_module_vts_v
    if [ -f "/var/hostvn/version" ]; then
        ngx_cache_purge_version=$(grep "^ngx_cache_purge_version=" /var/hostvn/version | cut -f2 -d'=')
        more_clear_headers_v=$(grep "^more_clear_headers_v=" /var/hostvn/version | cut -f2 -d'=')
        nginx_module_vts_v=$(grep "^nginx_module_vts_v=" /var/hostvn/version | cut -f2 -d'=')
    fi
    if [ -z "${ngx_cache_purge_version}" ]; then
        ngx_cache_purge_version=$(curl -s --max-time 10 "${UPDATE_LINK}"/version | grep "^ngx_cache_purge_version=" | cut -f2 -d'=')
    fi
    if [ -z "${more_clear_headers_v}" ]; then
        more_clear_headers_v=$(curl -s --max-time 10 "${UPDATE_LINK}"/version | grep "^more_clear_headers_v=" | cut -f2 -d'=')
    fi
    if [ -z "${nginx_module_vts_v}" ]; then
        nginx_module_vts_v=$(curl -s --max-time 10 "${UPDATE_LINK}"/version | grep "^nginx_module_vts_v=" | cut -f2 -d'=')
    fi

    ngx_cache_purge_version="${ngx_cache_purge_version:-2.5.6}"
    more_clear_headers_v="${more_clear_headers_v:-0.40}"
    nginx_module_vts_v="${nginx_module_vts_v:-0.2.5}"

    cd "${MODULE_PATH}" || return 1
    rm -rf "${MODULE_PATH:?}"/*

    printf "%s\n" "${GREEN}Dang tai ma nguon Nginx ${NGINX_BUILD_VERSION} va cac module...${NC}"
    if ! wget -qO- "https://nginx.org/download/nginx-${NGINX_BUILD_VERSION}.tar.gz" | tar -xz; then
        printf "%s\n" "${RED}Khong tai duoc Nginx phien ban ${NGINX_BUILD_VERSION}. Vui long kiem tra lai phien ban.${NC}"
        return 1
    fi
    if [ ! -d "${MODULE_PATH}/nginx-${NGINX_BUILD_VERSION}" ]; then
        printf "%s\n" "${RED}Giai nen Nginx that bai.${NC}"
        return 1
    fi

    # Fork nginx-modules/ngx_cache_purge tuong thich nginx moi (FRiCKLE goc da ngung phat trien)
    wget -qO- "https://github.com/nginx-modules/ngx_cache_purge/archive/refs/tags/${ngx_cache_purge_version}.tar.gz" | tar -xz || return 1
    wget -qO- "https://github.com/openresty/headers-more-nginx-module/archive/refs/tags/v${more_clear_headers_v}.tar.gz" | tar -xz || return 1
    wget -qO- "https://github.com/vozlt/nginx-module-vts/archive/refs/tags/v${nginx_module_vts_v}.tar.gz" | tar -xz || return 1
    if ! git clone --depth 1 https://github.com/google/ngx_brotli; then
        printf "%s\n" "${RED}Clone ngx_brotli that bai.${NC}"
        return 1
    fi
    (cd ngx_brotli && git submodule update --init) || return 1

    # Khong dung "service nginx stop" truoc khi build de web khong bi downtime trong luc compile!
    cd "${MODULE_PATH}/nginx-${NGINX_BUILD_VERSION}" || return 1
    ./configure \
        "--user=nginx" \
        "--group=nginx" \
        "--prefix=/usr" \
        "--sbin-path=/usr/sbin/nginx" \
        "--conf-path=/etc/nginx/nginx.conf" \
        "--pid-path=/var/run/nginx.pid" \
        "--http-log-path=/var/log/nginx/access_log" \
        "--error-log-path=/var/log/nginx/error_log" \
        "--without-mail_imap_module" \
        "--without-mail_smtp_module" \
        "--with-http_ssl_module" \
        "--with-http_realip_module" \
        "--with-http_stub_status_module" \
        "--with-http_gzip_static_module" \
        "--with-http_dav_module" \
        "--with-http_v2_module" \
        "--with-http_v3_module" \
        "--with-pcre-jit" \
        "--add-module=../ngx_cache_purge-${ngx_cache_purge_version}" \
        "--add-module=../headers-more-nginx-module-${more_clear_headers_v}" \
        "--add-module=../ngx_brotli" \
        "--add-module=../nginx-module-vts-${nginx_module_vts_v}" \
        "--with-cc-opt='-D FD_SETSIZE=32768'"

    printf "%s\n" "${GREEN}Dang bien dich Nginx ${NGINX_BUILD_VERSION}... (qua trinh mat 1-3 phut)${NC}"
    if ! make -j"$(nproc)"; then
        printf "%s\n" "${RED}Bien dich Nginx that bai! He thong giu nguyen ban Nginx cu dang chay.${NC}"
        return 1
    fi

    # Dung mv (khong dung cp) de doi ten inode dang chay sang .backup:
    # Neu giu nguyen file /usr/sbin/nginx dang chay, lenh cp trong make install se bi
    # kernel chan voi loi "Text file busy" va binary van giu phien ban cu!
    if [ -f /usr/sbin/nginx ]; then
        mv -f /usr/sbin/nginx /usr/sbin/nginx.backup
    fi

    if ! make install; then
        printf "%s\n" "${RED}Loi khi chay make install! Dang khoi phuc ban Nginx cu...${NC}"
        [ -f /usr/sbin/nginx.backup ] && mv -f /usr/sbin/nginx.backup /usr/sbin/nginx
        return 1
    fi

    # Dam bao binary moi duoc chep dung vao /usr/sbin/nginx
    if [ -f objs/nginx ]; then
        cp -f objs/nginx /usr/sbin/nginx
        chmod 755 /usr/sbin/nginx
    fi

    if [ ! -x "/usr/sbin/nginx" ]; then
        printf "%s\n" "${RED}Khong tim thay /usr/sbin/nginx sau khi cai dat. Dang khoi phuc ban cu...${NC}"
        [ -f /usr/sbin/nginx.backup ] && mv -f /usr/sbin/nginx.backup /usr/sbin/nginx
        return 1
    fi

    local INSTALLED_NGINX_VER
    INSTALLED_NGINX_VER=$(/usr/sbin/nginx -v 2>&1 | grep -o '[0-9.]*$')
    if [ "${INSTALLED_NGINX_VER}" != "${NGINX_BUILD_VERSION}" ]; then
        printf "%s\n" "${RED}Loi: Binary sau khi cai (${INSTALLED_NGINX_VER}) khong khop voi phien ban ${NGINX_BUILD_VERSION}!${NC}"
        [ -f /usr/sbin/nginx.backup ] && mv -f /usr/sbin/nginx.backup /usr/sbin/nginx
        return 1
    fi

    rm -f /usr/sbin/nginx.old /usr/sbin/nginx.backup

    # Khoa goi APT de apt upgrade he thong khong bao gio de binary bang ban Ubuntu/nginx.org (thieu module)
    apt-mark hold nginx nginx-common nginx-core nginx-full 2>/dev/null || true
    # Xoa bo repo nginx deb ngoai neu co de tranh xung dot va loi GPG/apt update
    rm -f /etc/apt/sources.list.d/nginx.list /etc/apt/sources.list.d/nginx.sources 2>/dev/null || true

    return 0
}

printf "%s=============================%s\n" "${GREEN}" "${NC}"
printf "%s        Nginx Manager        %s\n" "${GREEN}" "${NC}"
printf "%s=============================%s\n" "${GREEN}" "${NC}"
printf "%sNginx version : %s%s\n" "${GREEN}" "${nginx_v}" "${NC}"
printf "%s=============================%s\n" "${GREEN}" "${NC}"
printf "%sStatus: %s%s\n" "${GREEN}" "${nginx_status}" "${NC}"
printf "%s=============================%s\n" "${GREEN}" "${NC}"

while [ "${CHOICE}" != "0" ]; do
    printf "%s1. Restart Nginx%s\n" "${GREEN}" "${NC}"
    printf "%s2. ${lang_test_nginx_config}%s\n" "${GREEN}" "${NC}"
    printf "%s3. Update Nginx%s\n" "${GREEN}" "${NC}"
    printf "%s4. Rebuild Nginx%s\n" "${GREEN}" "${NC}"
    printf "%s=========================%s\n" "${GREEN}" "${NC}"
    read -r -p " ${SELECT_OPTION} " CHOICE

    if [ -z "${CHOICE}" ]; then
        CHOICE=1
        continue
    fi
    case ${CHOICE} in
    1)
        clear
        printf "%s\n" "${RED}${PROCESSING}${NC}"
        sleep 1
        if nginx -t; then
            systemctl restart nginx
            clear
            printf "%s\n" "${GREEN}${lang_restart_nginx_success}${NC}"
            sleep 1
            echo
        else
            nginx -t
            printf "%s\n" "${RED}${lang_nginx_config_error}${NC}"
        fi

        lemp_nginx
        ;;
    2)
        clear
        sleep 1
        nginx -t
        sleep 1
        echo
        lemp_nginx
        ;;
    3)
        clear
        NGINX_CURRENT_VERSION=$(nginx -v 2>&1 | grep -o '[0-9.]*$')
        NGINX_NEW_VERSION=$(_detect_latest_nginx)

        printf "%s==================================================%s\n" "${GREEN}" "${NC}"
        printf "%s                   Update Nginx                   %s\n" "${GREEN}" "${NC}"
        printf "%s==================================================%s\n" "${GREEN}" "${NC}"
        printf "Phien ban Nginx hien tai : %s\n" "${GREEN}${NGINX_CURRENT_VERSION}${NC}"
        printf "Phien ban Nginx moi nhat : %s\n" "${GREEN}${NGINX_NEW_VERSION}${NC}"
        printf "%s==================================================%s\n" "${GREEN}" "${NC}"
        printf "1. Nang cap len phien ban moi nhat (%s)\n" "${NGINX_NEW_VERSION}"
        printf "2. Nhap phien ban Nginx tuy chon (VD: 1.26.3, 1.28.0, %s)\n" "${NGINX_NEW_VERSION}"
        printf "0. Quay lai\n"
        printf "%s==================================================%s\n" "${GREEN}" "${NC}"
        read -r -p "Nhap lua chon cua ban [1 - 2, 0 = Huy]: " NGINX_UP_CHOICE

        TARGET_NGINX_VER=""
        case ${NGINX_UP_CHOICE} in
        1)
            TARGET_NGINX_VER="${NGINX_NEW_VERSION}"
            ;;
        2)
            read -r -p "Nhap phien ban Nginx muon cai dat: " USER_CUSTOM_VER
            if [[ "${USER_CUSTOM_VER}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                TARGET_NGINX_VER="${USER_CUSTOM_VER}"
            else
                clear
                printf "%s\n" "${RED}Dinh dang phien ban khong hop le (VD hop le: 1.26.3, 1.30.4).${NC}"
                sleep 2
                lemp_nginx
                continue
            fi
            ;;
        0)
            clear
            lemp_nginx
            continue
            ;;
        *)
            clear
            printf "%s\n" "${RED}Lua chon khong chinh xac.${NC}"
            sleep 1
            lemp_nginx
            continue
            ;;
        esac

        if [ -n "${TARGET_NGINX_VER}" ]; then
            clear
            if _build_nginx "${TARGET_NGINX_VER}"; then
                if nginx -t; then
                    systemctl restart nginx
                    clear
                    printf "%s\n" "${GREEN}Update Nginx len ${TARGET_NGINX_VER} thanh cong!${NC}"
                else
                    clear
                    nginx -t
                    printf "%s\n" "${RED}${lang_nginx_config_error}${NC}"
                fi
            else
                printf "%s\n" "${RED}Update Nginx that bai.${NC}"
            fi
            sleep 2
        fi

        lemp_nginx
        ;;
    4)
        clear
        NGINX_CURRENT_VERSION=$(nginx -v 2>&1 | grep -o '[0-9.]*$')
        NGINX_VERSION=$(_detect_latest_nginx)
        NGINX_BUILD_TARGET="${NGINX_CURRENT_VERSION:-${NGINX_VERSION:-1.30.6}}"

        printf "%s\n" "${GREEN}Bat dau Rebuild Nginx ${NGINX_BUILD_TARGET}...${NC}"
        if _build_nginx "${NGINX_BUILD_TARGET}"; then
            # Chi tao nginx.conf neu file chua ton tai (tranh xoa mat cau hinh tuy bien cua user)
            if [ ! -f "/etc/nginx/nginx.conf" ]; then
                CPU_CORES=$(grep -c "processor" /proc/cpuinfo)
                MAX_CLIENT=$((CPU_CORES * 1024))
                cat >"/etc/nginx/nginx.conf" <<EONGINXCONF
user nginx;
worker_processes auto;
worker_rlimit_nofile 260000;

error_log  /var/log/nginx/error.log warn;
pid        /run/nginx.pid;

events {
    worker_connections ${MAX_CLIENT};
    accept_mutex off;
    accept_mutex_delay 200ms;
    use epoll;
    #multi_accept on;
}

http {
    index  index.html index.htm index.php;
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    charset utf-8;

    log_format  main  '\$remote_addr - \$remote_user [\$time_local] "\$request" '
                  '\$status \$body_bytes_sent "\$http_referer" '
                  '"\$http_user_agent" "\$http_x_forwarded_for"';

    access_log  off;
    server_tokens off;

    sendfile on;

    tcp_nopush on;
    tcp_nodelay off;

    types_hash_max_size 2048;
    server_names_hash_bucket_size 128;
    server_names_hash_max_size 10240;
    client_max_body_size 1024m;
    client_body_buffer_size 128k;
    client_body_in_file_only off;
    client_body_timeout 60s;
    client_header_buffer_size 256k;
    client_header_timeout  20s;
    large_client_header_buffers 8 256k;
    keepalive_timeout 15;
    keepalive_disable msie6;
    reset_timedout_connection on;
    send_timeout 60s;

    disable_symlinks if_not_owner from=\$document_root;
    server_name_in_redirect off;

    open_file_cache max=2000 inactive=20s;
    open_file_cache_valid 120s;
    open_file_cache_min_uses 2;
    open_file_cache_errors off;

    # Limit Request
    limit_req_status 403;
    # limit the number of connections per single IP
    limit_conn_zone \$binary_remote_addr zone=conn_limit_per_ip:10m;
    # limit the number of requests for a given session
    limit_req_zone \$binary_remote_addr zone=req_limit_per_ip:10m rate=1r/s;

    # Custom Response Headers
    more_set_headers 'Server: GITHUB.COM';
    more_set_headers 'X-Frame-Options           "SAMEORIGIN" always';
    more_set_headers 'X-Content-Type-Options    "nosniff" always';
    more_set_headers 'X-XSS-Protection          "1; mode=block" always';
    more_set_headers 'Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always';
    more_set_headers 'Referrer-Policy no-referrer-when-downgrade';

    # Custom Variables
    map \$scheme \$https_suffix { default ''; https '-https'; }

    include /etc/nginx/extra/nginx_cache.conf;
    include /etc/nginx/extra/gzip.conf;
    include /etc/nginx/extra/brotli.conf;
    include /etc/nginx/extra/ssl.conf;
    include /etc/nginx/extra/cloudflare.conf;
    include /etc/nginx/web_apps.conf;
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/redirect/*.conf;
}
EONGINXCONF
            fi

            if nginx -t; then
                systemctl restart nginx
                clear
                printf "%s\n" "${GREEN}Rebuild Nginx successful.${NC}"
            else
                clear
                nginx -t
                printf "%s\n" "${RED}${lang_nginx_config_error}${NC}"
            fi
        else
            printf "%s\n" "${RED}Rebuild Nginx that bai.${NC}"
        fi
        sleep 2
        lemp_nginx
        ;;
    0)
        clear
        menu_lemp
        ;;
    *)
        clear
        printf "%s\n" "${RED}${WRONG_OPTION}${NC}"
        ;;
    esac
done
