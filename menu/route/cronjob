CHOICE=1

printf "%s==============================================%s\n" "${GREEN}" "${NC}"
printf "%s                Cronjob manager               %s\n" "${GREEN}" "${NC}"
printf "%s==============================================%s\n" "${GREEN}" "${NC}"

while [ "${CHOICE}" != "0" ]
do
    printf "%s1. ${lang_list_cronjob} %s\n" "${GREEN}" "${NC}"
    printf "%s2. ${lang_cronjob_backup_local} %s\n" "${GREEN}" "${NC}"
    printf "%s3. ${lang_cronjob_backup_to_gg}%s\n" "${GREEN}" "${NC}"
    printf "%s4. Cronjob backup to OneDrive%s\n" "${GREEN}" "${NC}"
    printf "%s5. ${lang_custom_cronjob}%s\n" "${GREEN}" "${NC}"
    printf "%s6. Delete cronjob%s\n" "${GREEN}" "${NC}"
    printf "%s=============================================%s\n" "${GREEN}" "${NC}"
    read -r -p " ${SELECT_OPTION} " CHOICE
    if [ -z "${CHOICE}" ]
    then
        CHOICE=1
        continue
    fi
    case ${CHOICE} in
        1)
            clear
            echo ""
            cron=$(crontab -l 2>/dev/null)
            printf "${RED}%s${NC}\n" "${cron}"
            if [ -d "/var/hostvn/ggdrive" ] && [ -n "$(ls -A /var/hostvn/ggdrive 2>/dev/null)" ]; then
                printf "\n${GREEN}Ten mien auto backup Google Drive:${NC} %s\n" "$(ls -1 /var/hostvn/ggdrive 2>/dev/null | tr '\n' ' ')"
            fi
            if [ -d "/var/hostvn/onedrive" ] && [ -n "$(ls -A /var/hostvn/onedrive 2>/dev/null)" ]; then
                printf "\n${GREEN}Ten mien auto backup OneDrive:${NC} %s\n" "$(ls -1 /var/hostvn/onedrive 2>/dev/null | tr '\n' ' ')"
            fi
            echo ""
            ;;
        2) clear; cron_backup_local ;;
        3) clear; cron_backup_google ;;
        4) clear; cron_backup_onedrive ;;
        5)
            clear
            printf "%s\n" "${lang_open_nano}."
            printf "%s\n" "${lang_instructions_for_using_nano}: https://blog.hostvn.net/chia-se/huong-dan-su-dung-nano-tren-linux.html"
            sleep 4
            EDITOR=nano crontab -e
            menu_cronjob
            ;;
        6) clear; cron_destroy ;;
        0) clear; menu_primary ;;
        *) clear; printf "%s\n" "${RED}${WRONG_OPTION}${NC}";;
    esac
done
