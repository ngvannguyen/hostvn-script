source /var/hostvn/ipaddress
source /var/hostvn/.hostvn.conf
source /var/hostvn/menu/helpers/variable_common

LOG="/var/log/rclone.log"

# Kiem tra remote co ton tai trong rclone.conf khong
if ! rclone listremotes 2>/dev/null | grep -q "^${remote}:"; then
    echo "[$(date)] ERROR: Remote '${remote}' khong ton tai trong rclone config. Huy backup." >> "${LOG}"
    exit 1
fi

for users in /home/*; do
    if [[ -d "${users}" ]]; then
        user=${users##*/}
        for domains in /home/"${user}"/*; do
            if [[ -d "${domains}" ]]; then
                domain=${domains##*/}
                for publics in /home/${user}/${domain}/public_html; do
                    if [[ -d "${publics}" ]]; then
                        public=${publics##*/}
                        db_name=$(grep -w "db_name" "${USER_DIR}/.${domain}.conf" 2>/dev/null | cut -f2 -d'=')

                        backup_dir="/home/backup/${CURRENT_DATE}/${domain}"
                        mkdir -p "${backup_dir}"
                        rm -rf "${backup_dir:?}"/*

                        # Dump database (neu co)
                        if [ -n "${db_name}" ]; then
                            cd "${backup_dir}" || continue
                            mariadb-dump -uadmin -p"${mysql_pwd}" "${db_name}" 2>/dev/null | gzip > "${db_name}".sql.gz
                        fi

                        # Nen source code
                        cd /home/"${user}"/"${domain}" || continue
                        if [[ ! -f "/home/${user}/${domain}/public_html/wp-config.php" && -f "/home/${user}/${domain}/wp-config.php" ]]; then
                            cp /home/"${user}"/"${domain}"/wp-config.php /home/"${user}"/"${domain}"/public_html/wp-config.php
                        fi
                        if [ -d "/home/${user}/${domain}/public_html/storage" ]; then
                            tar -cpzf "${backup_dir}/${domain}.tar.gz" \
                                --exclude "public_html/storage/framework/cache" --exclude "public_html/storage/framework/views" "${public}"
                        else
                            tar -cpzf "${backup_dir}/${domain}.tar.gz" \
                                --exclude "public_html/wp-content/cache" "${public}"
                        fi

                        # Upload len Google Drive - CHI xoa local khi upload thanh cong
                        if rclone copy "${backup_dir}" "${remote}":"${IPADDRESS}"/"${CURRENT_DATE}"/"${domain}" --bwlimit 30M >> "${LOG}" 2>&1; then
                            rm -rf "${backup_dir}"
                            echo "[$(date)] OK: ${domain} - Upload thanh cong." >> "${LOG}"
                        else
                            echo "[$(date)] ERROR: ${domain} - Upload that bai. Giu lai backup local tai ${backup_dir}" >> "${LOG}"
                        fi

                        # Don dep wp-config.php tam
                        if [[ -f "/home/${user}/${domain}/public_html/wp-config.php" && -f "/home/${user}/${domain}/wp-config.php" ]]; then
                            rm -rf /home/"${user}"/"${domain}"/public_html/wp-config.php
                        fi
                    fi
                done
            fi
        done
    fi
done

# Xoa backup cu tren Google Drive
rclone -q --min-age "${backup_num}"d delete "${remote}:$IPADDRESS" >> "${LOG}" 2>&1
rclone -q --min-age "${backup_num}"d rmdirs "${remote}:$IPADDRESS" >> "${LOG}" 2>&1
