source /var/hostvn/ipaddress
source /var/hostvn/.hostvn.conf
source /var/hostvn/menu/helpers/variable_common

LOG="/var/log/rclone.log"
TARGET_DOMAIN="$1"

_backup_single_domain() {
    local domain="$1"
    local cfg_file="${BASH_DIR}/ggdrive/${domain}"
    [ -f "${cfg_file}" ] || return 0
    [[ -f "${USER_DIR}/.${domain}.conf" ]] || return 0

    local d_remote d_backup_num user db_name backup_dir
    d_remote=$(grep -w '^remote' "${cfg_file}" 2>/dev/null | cut -f2 -d'=')
    d_backup_num=$(grep -w '^backup_num' "${cfg_file}" 2>/dev/null | cut -f2 -d'=')
    [ -z "${d_remote}" ] && d_remote="${remote}"
    [ -z "${d_backup_num}" ] && d_backup_num="${backup_num}"

    if [ -z "${d_remote}" ] || ! rclone listremotes 2>/dev/null | grep -q "^${d_remote}:"; then
        echo "[$(date)] ERROR: Remote '${d_remote}' cho ${domain} khong ton tai trong rclone config. Huy backup." >> "${LOG}"
        return 1
    fi

    user=$(grep -w "username" "${USER_DIR}/.${domain}.conf" | cut -f2 -d'=')
    db_name=$(grep -w "db_name" "${USER_DIR}/.${domain}.conf" 2>/dev/null | cut -f2 -d'=')

    backup_dir="/home/backup/${CURRENT_DATE}/${domain}"
    mkdir -p "${backup_dir}"
    rm -rf "${backup_dir:?}"/*

    # Dump database (neu co)
    if [ -n "${db_name}" ]; then
        cd "${backup_dir}" || return 1
        mariadb-dump -uadmin -p"${mysql_pwd}" "${db_name}" 2>/dev/null | gzip > "${db_name}".sql.gz
    fi

    # Nen source code
    cd /home/"${user}"/"${domain}" || return 1
    if [[ ! -f "/home/${user}/${domain}/public_html/wp-config.php" && -f "/home/${user}/${domain}/wp-config.php" ]]; then
        cp /home/"${user}"/"${domain}"/wp-config.php /home/"${user}"/"${domain}"/public_html/wp-config.php
    fi
    if [ -d "/home/${user}/${domain}/public_html/storage" ]; then
        tar -cpzf "${backup_dir}/${domain}.tar.gz" \
            --exclude "public_html/storage/framework/cache" --exclude "public_html/storage/framework/views" public_html
    else
        tar -cpzf "${backup_dir}/${domain}.tar.gz" \
            --exclude "public_html/wp-content/cache" public_html
    fi

    # Upload len Google Drive - CHI xoa local khi upload thanh cong
    if rclone copy "${backup_dir}" "${d_remote}":"${IPADDRESS}"/"${CURRENT_DATE}"/"${domain}" --bwlimit 30M >> "${LOG}" 2>&1; then
        rm -rf "${backup_dir}"
        echo "[$(date)] OK: ${domain} - Upload thanh cong len ${d_remote}." >> "${LOG}"
    else
        echo "[$(date)] ERROR: ${domain} - Upload that bai. Giu lai backup local tai ${backup_dir}" >> "${LOG}"
    fi

    # Don dep wp-config.php tam
    if [[ -f "/home/${user}/${domain}/public_html/wp-config.php" && -f "/home/${user}/${domain}/wp-config.php" ]]; then
        rm -rf /home/"${user}"/"${domain}"/public_html/wp-config.php
    fi

    # Xoa backup cu cua rieng ten mien nay tren Google Drive
    if [[ -n "${d_backup_num}" && "${d_backup_num}" =~ ^[0-9]+$ ]]; then
        rclone -q --min-age "${d_backup_num}"d --include "*/${domain}/**" delete "${d_remote}:${IPADDRESS}" >> "${LOG}" 2>&1
        rclone -q --min-age "${d_backup_num}"d rmdirs "${d_remote}:${IPADDRESS}" >> "${LOG}" 2>&1
    fi
}

if [ -n "${TARGET_DOMAIN}" ]; then
    _backup_single_domain "${TARGET_DOMAIN}"
else
    for domains in "${BASH_DIR}"/ggdrive/*; do
        [ -f "${domains}" ] || continue
        domain=$(basename "${domains}")
        _backup_single_domain "${domain}"
    done
fi
