source /var/hostvn/ipaddress
source /var/hostvn/.hostvn.conf
source /var/hostvn/menu/helpers/variable_common
onedrive_folder_name=$(grep -w "onedrive_folder_name" "${FILE_INFO}" | cut -f2 -d'=')

LOG="/var/log/rclone.log"

exec 9>/var/lock/hostvn_cloud_backup.lock
flock 9

# Kiem tra remote onedrive co ton tai khong
if ! rclone listremotes 2>/dev/null | grep -q "^onedrive:"; then
    echo "[$(date)] ERROR: Remote 'onedrive' khong ton tai trong rclone config. Huy backup." >> "${LOG}"
    exit 1
fi

for users in /home/*; do
    if [[ -d "${users}" ]]; then
        user=${users##*/}
        for domains in /home/"${user}"/*; do
            if [[ -d "${domains}" ]]; then
                domain=${domains##*/}
                for publics in /home/${user}/${domain}/public_html; do
                    if [[ -d "${publics}" ]]; then
                        public=${publics##*/}
                        db_name=$(grep -w "db_name" "${USER_DIR}/.${domain}.conf" 2>/dev/null | cut -f2 -d'=')

                        backup_dir="/home/backup/${CURRENT_DATE}/${domain}"
                        mkdir -p "${backup_dir}"
                        rm -rf "${backup_dir:?}"/*

                        # Dump database (neu co)
                        if [ -n "${db_name}" ]; then
                            cd "${backup_dir}" || continue
                            mariadb-dump -uadmin -p"${mysql_pwd}" "${db_name}" 2>/dev/null | gzip > "${db_name}".sql.gz
                            if [ "${PIPESTATUS[0]}" -ne 0 ] || [ ! -s "${db_name}.sql.gz" ]; then
                                rm -f "${db_name}.sql.gz"
                                echo "[$(date)] WARN: ${domain} - Dump database '${db_name}' that bai (bo qua file sql rong)." >> "${LOG}"
                            fi
                        fi

                        # Nen source code
                        cd /home/"${user}"/"${domain}" || continue
                        if [[ ! -f "/home/${user}/${domain}/public_html/wp-config.php" && -f "/home/${user}/${domain}/wp-config.php" ]]; then
                            cp /home/"${user}"/"${domain}"/wp-config.php /home/"${user}"/"${domain}"/public_html/wp-config.php
                        fi
                        if [ -d "/home/${user}/${domain}/public_html/storage" ]; then
                            tar -cpzf "${backup_dir}/${domain}.tar.gz" \
                                --exclude "public_html/storage/framework/cache" --exclude "public_html/storage/framework/views" "${public}"
                            tar_rc=$?
                        else
                            tar -cpzf "${backup_dir}/${domain}.tar.gz" \
                                --exclude "public_html/wp-content/cache" "${public}"
                            tar_rc=$?
                        fi

                        # Don dep wp-config.php tam ngay sau khi nen
                        if [[ -f "/home/${user}/${domain}/public_html/wp-config.php" && -f "/home/${user}/${domain}/wp-config.php" ]]; then
                            rm -rf /home/"${user}"/"${domain}"/public_html/wp-config.php
                        fi

                        if [ "${tar_rc}" -ge 2 ] || [ ! -s "${backup_dir}/${domain}.tar.gz" ]; then
                            echo "[$(date)] ERROR: ${domain} - Nen ma nguon that bai (tar exit=${tar_rc}). Huy upload OneDrive." >> "${LOG}"
                            continue
                        fi

                        # Upload len OneDrive - CHI xoa local khi upload thanh cong
                        if rclone copy "${backup_dir}" "onedrive:${onedrive_folder_name}/${IPADDRESS}/${CURRENT_DATE}/${domain}" --bwlimit 30M >> "${LOG}" 2>&1; then
                            rm -rf "${backup_dir}"
                            echo "[$(date)] OK: ${domain} - Upload OneDrive thanh cong." >> "${LOG}"
                        else
                            echo "[$(date)] ERROR: ${domain} - Upload OneDrive that bai. Giu lai backup local tai ${backup_dir}" >> "${LOG}"
                        fi
                    fi
                done
            fi
        done
    fi
done

# Xoa backup cu tren OneDrive
rclone -q --min-age "${backup_num}"d delete "onedrive:${onedrive_folder_name}/${IPADDRESS}" >> "${LOG}" 2>&1
rclone -q --min-age "${backup_num}"d rmdirs "onedrive:${onedrive_folder_name}/${IPADDRESS}" >> "${LOG}" 2>&1
